# ==============================================================================
# LISTAIASSETS ENVIRONMENT CONFIGURATION
# Production Domain: https://listaiassets.com
# Supabase PostgreSQL + Netlify Functions & Next.js Runtime
# ==============================================================================

# Supabase PostgreSQL Connections
# Pooled connection (Transaction mode, typically port 6543) - ideal for serverless Next.js functions
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (Session mode, port 5432) - required for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Netlify Deployment Configuration
NETLIFY_SITE_ID="your-netlify-site-id"
NETLIFY_AUTH_TOKEN="your-netlify-personal-access-token"

# App Settings
# Set to https://listaiassets.com in production, http://localhost:3000 in local dev
NEXT_PUBLIC_SITE_URL="https://listaiassets.com"
NEXT_PUBLIC_APP_ENV="production"

# Google Search Console & Google Analytics 4 (GA4)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="google-site-verification-token"

# Payment Option A: Lemon Squeezy (Supports Payoneer/Wise payouts in Pakistan without US LLC)
# LEMON_SQUEEZY_FAST_TRACK_URL="https://listaiassets.lemonsqueezy.com/buy/..."
# LEMON_SQUEEZY_FEATURED_URL="https://listaiassets.lemonsqueezy.com/buy/..."
# LEMON_SQUEEZY_WEBHOOK_SECRET="your_lemon_squeezy_webhook_signing_secret"

# Payment Option B: Stripe (Requires US LLC + Mercury Bank or international Stripe account)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Admin Review Queue Passkey (Default: listaiassets_admin)
ADMIN_SECRET_KEY="listaiassets_admin"

# Instant Owner Alerts (Zero mandatory dependencies; works out-of-the-box without these)
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# TELEGRAM_BOT_TOKEN="123456:ABC-..."
# TELEGRAM_CHAT_ID="your_chat_id"
